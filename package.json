{
  "name": "vocalis-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:ts": "tsc",
    "build:css": "sass src/style.scss static/style.css --no-source-map",
    "build": "npm run build:ts && npm run build:css",
    "watch:ts": "tsc --watch",
    "watch:css": "sass --watch src/style.scss static/style.css --no-source-map"
  },
  "devDependencies": {
    "@tonejs/midi": "^2.0.28",
    "sass": "^1.80.0",
    "tone": "^14.7.77",
    "typescript": "^5.6.0"
  }
}
